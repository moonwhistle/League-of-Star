{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "리그 오브 스마이트 - 매칭 응답",
  "uid": "smite-match-response",
  "timezone": "browser",
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": [
    "smite",
    "matching",
    "response",
    "timeout"
  ],
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "API 인스턴스",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(up{job=\"smite-api\"}, instance)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "요약",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "title": "수락/거절 요청 처리량",
      "description": "accept/reject 명령 API의 시도/성공/실패 카운터입니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum by (action, result) (rate(match_response_requests_total{instance=~\"$instance\"}[1m]))",
          "legendFormat": "{{action}} {{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 3,
      "title": "수락/거절 실패율",
      "description": "accept/reject 요청 중 실패 비율입니다. reason별 상세는 요청 처리량과 로그를 함께 확인합니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(rate(match_response_requests_total{instance=~\"$instance\", result=\"failure\"}[5m])) / clamp_min(sum(rate(match_response_requests_total{instance=~\"$instance\", result=\"attempt\"}[5m])), 0.001) * 100",
          "legendFormat": "실패율",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 4,
      "title": "최종 완료 상태",
      "description": "양쪽 수락 완료와 거절 완료로 최종 종료된 match session 처리량입니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(match_response_completions_total{instance=~\"$instance\"}[1m]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 5,
      "title": "matchId Lock 실패",
      "description": "accept/reject 명령이 matchId lock을 얻지 못한 횟수입니다. 값이 증가하면 응답 경합 또는 lock wait 설정을 확인합니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum by (action) (rate(match_response_lock_failures_total{instance=~\"$instance\"}[1m]))",
          "legendFormat": "{{action}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 6,
      "title": "Timeout",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      }
    },
    {
      "id": 7,
      "title": "Timeout Backlog",
      "description": "pending/processing/overdue timeout job의 현재 수입니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(match_response_timeout_pending_backlog{instance=~\"$instance\"})",
          "legendFormat": "pending",
          "refId": "A"
        },
        {
          "expr": "sum(match_response_timeout_processing_backlog{instance=~\"$instance\"})",
          "legendFormat": "processing",
          "refId": "B"
        },
        {
          "expr": "sum(match_response_timeout_overdue_pending{instance=~\"$instance\"})",
          "legendFormat": "overdue pending",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 8,
      "title": "Timeout Claim/Reclaim",
      "description": "timeout job claim/reclaim 결과별 처리량입니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(match_response_timeout_claims_total{instance=~\"$instance\"}[1m]))",
          "legendFormat": "claim {{outcome}}",
          "refId": "A"
        },
        {
          "expr": "sum by (outcome) (rate(match_response_timeout_reclaims_total{instance=~\"$instance\"}[1m]))",
          "legendFormat": "reclaim {{outcome}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 9,
      "title": "Timeout 정산 결과",
      "description": "timeout 정산의 success/no_op/failure 처리량입니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(match_response_timeout_settlements_total{instance=~\"$instance\"}[1m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 10,
      "title": "Timeout 큐 복귀 유저",
      "description": "timeout 정산 결과 기존에 수락했던 유저가 원래 entryTime으로 큐에 복귀한 수입니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "targets": [
        {
          "expr": "sum(rate(match_response_timeout_queue_returned_users_total{instance=~\"$instance\"}[1m]))",
          "legendFormat": "큐 복귀 유저",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 11,
      "title": "Timeout 정산 지연",
      "description": "deadline 대비 실제 timeout 정산 시도까지 지연된 시간입니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 30
      },
      "targets": [
        {
          "expr": "1000 * sum(rate(match_response_timeout_processing_delay_seconds_sum{instance=~\"$instance\"}[1m])) / clamp_min(sum(rate(match_response_timeout_processing_delay_seconds_count{instance=~\"$instance\"}[1m])), 0.001)",
          "legendFormat": "평균",
          "refId": "A"
        },
        {
          "expr": "1000 * histogram_quantile(0.95, sum(rate(match_response_timeout_processing_delay_seconds_bucket{instance=~\"$instance\"}[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 12,
      "title": "Timeout Batch 소요 시간",
      "description": "scheduler tick 1회에서 reclaim과 due pending 처리를 수행하는 데 걸린 시간입니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 30
      },
      "targets": [
        {
          "expr": "1000 * sum(rate(match_response_timeout_batch_duration_seconds_sum{instance=~\"$instance\"}[1m])) / clamp_min(sum(rate(match_response_timeout_batch_duration_seconds_count{instance=~\"$instance\"}[1m])), 0.001)",
          "legendFormat": "평균",
          "refId": "A"
        },
        {
          "expr": "1000 * histogram_quantile(0.95, sum(rate(match_response_timeout_batch_duration_seconds_bucket{instance=~\"$instance\"}[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 13,
      "title": "Load Test Totals",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 37
      }
    },
    {
      "id": 14,
      "title": "요청 성공 증가량 추이",
      "description": "accept/reject 성공과 실패가 구간별로 얼마나 증가했는지 봅니다. legend의 sum 값은 선택한 시간대의 총량으로 부하테스트 summary와 비교합니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 38
      },
      "targets": [
        {
          "expr": "sum(increase(match_response_requests_total{instance=~\"$instance\", action=\"accept\", result=\"success\"}[$__rate_interval]))",
          "legendFormat": "accept success",
          "refId": "A"
        },
        {
          "expr": "sum(increase(match_response_requests_total{instance=~\"$instance\", action=\"reject\", result=\"success\"}[$__rate_interval]))",
          "legendFormat": "reject success",
          "refId": "B"
        },
        {
          "expr": "sum(increase(match_response_requests_total{instance=~\"$instance\", result=\"failure\"}[$__rate_interval]))",
          "legendFormat": "failure",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "sum"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 15,
      "title": "Timeout 정산 증가량 추이",
      "description": "timeout claim/settlement/큐 복귀가 구간별로 얼마나 증가했는지 봅니다. one_accept_other_timeout에서는 settlement success와 returned users의 sum이 handled pairs에 근접해야 합니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 38
      },
      "targets": [
        {
          "expr": "sum(increase(match_response_timeout_claims_total{instance=~\"$instance\", outcome=\"claimed\"}[$__rate_interval]))",
          "legendFormat": "claim claimed",
          "refId": "A"
        },
        {
          "expr": "sum(increase(match_response_timeout_settlements_total{instance=~\"$instance\", outcome=\"success\"}[$__rate_interval]))",
          "legendFormat": "settlement success",
          "refId": "B"
        },
        {
          "expr": "sum(increase(match_response_timeout_settlements_total{instance=~\"$instance\", outcome=\"failure\"}[$__rate_interval]))",
          "legendFormat": "settlement failure",
          "refId": "C"
        },
        {
          "expr": "sum(increase(match_response_timeout_queue_returned_users_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "returned users",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "sum"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 16,
      "title": "최종 완료 증가량 추이",
      "description": "최종 ACCEPTED/DECLINED 완료가 구간별로 얼마나 증가했는지 봅니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 45
      },
      "targets": [
        {
          "expr": "sum(increase(match_response_completions_total{instance=~\"$instance\", result=\"accepted\"}[$__rate_interval]))",
          "legendFormat": "accepted",
          "refId": "A"
        },
        {
          "expr": "sum(increase(match_response_completions_total{instance=~\"$instance\", result=\"declined\"}[$__rate_interval]))",
          "legendFormat": "declined",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "sum"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 17,
      "title": "SSE Result 증가량 추이",
      "description": "match_response_result Pub/Sub과 SSE 전송이 구간별로 얼마나 증가했는지 봅니다. 멀티 인스턴스에서는 received가 publish보다 인스턴스 수만큼 커질 수 있습니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 45
      },
      "targets": [
        {
          "expr": "sum(increase(sse_notification_pubsub_publish_success_total{instance=~\"$instance\", event=\"match_response_result\"}[$__rate_interval]))",
          "legendFormat": "pubsub publish",
          "refId": "A"
        },
        {
          "expr": "sum(increase(sse_notification_pubsub_messages_received_total{instance=~\"$instance\", event=\"match_response_result\"}[$__rate_interval]))",
          "legendFormat": "pubsub received",
          "refId": "B"
        },
        {
          "expr": "sum(increase(sse_notification_events_send_success_total{instance=~\"$instance\", event=\"match_response_result\"}[$__rate_interval]))",
          "legendFormat": "sse send success",
          "refId": "C"
        },
        {
          "expr": "sum(increase(sse_notification_events_send_failures_total{instance=~\"$instance\", event=\"match_response_result\"}[$__rate_interval]))",
          "legendFormat": "sse send failure",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "sum"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 18,
      "title": "JVM / 애플리케이션 리소스",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 52
      }
    },
    {
      "id": 19,
      "title": "CPU 사용률",
      "description": "API 인스턴스별 process/system CPU 사용률입니다. 부하테스트 중 특정 인스턴스만 튀는지 확인합니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 53
      },
      "targets": [
        {
          "expr": "process_cpu_usage{instance=~\"$instance\"} * 100",
          "legendFormat": "{{instance}} process",
          "refId": "A"
        },
        {
          "expr": "system_cpu_usage{instance=~\"$instance\"} * 100",
          "legendFormat": "{{instance}} system",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
