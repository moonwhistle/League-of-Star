{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "리그 오브 스마이트 - 매칭 엔진",
  "uid": "league-of-star-match-engine",
  "timezone": "browser",
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": [
    "lightning",
    "matching",
    "engine"
  ],
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "API 인스턴스",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(up{job=\"league-of-star-api\"}, instance)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "요약",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "title": "초당 매칭 성사 수",
      "description": "Redis 원자 제거에 성공하여 성사된 페어 수입니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(rate(match_engine_pairs_total{instance=~\"$instance\"}[1m]))",
          "legendFormat": "초당 페어 수",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        }
      }
    },
    {
      "id": 3,
      "title": "전체 대기 인원",
      "description": "모든 티어 큐에 남아 있는 현재 대기 유저 수입니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(max by (tier) (match_queue_size{instance=~\"$instance\"}))",
          "legendFormat": "대기 인원",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        }
      }
    },
    {
      "id": 4,
      "title": "원자 배치 선점 실패율",
      "description": "Lua 원자 배치 선점 실패 수 / 시도 수입니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(rate(match_engine_atomic_batch_failures_total{instance=~\"$instance\"}[5m])) / clamp_min(sum(rate(match_engine_atomic_batch_attempts_total{instance=~\"$instance\"}[5m])), 0.001) * 100",
          "legendFormat": "실패율",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 15
              }
            ]
          }
        }
      },
      "options": {
        "legend": {
          "showLegend": true
        }
      }
    },
    {
      "id": 5,
      "title": "분당 락 스킵 수",
      "description": "다른 인스턴스가 매칭 엔진 락을 보유하여 이번 스캔을 건너뛴 횟수입니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(increase(match_engine_lock_skipped_total{instance=~\"$instance\"}[1m]))",
          "legendFormat": "분당 스킵 수",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        }
      }
    },
    {
      "id": 6,
      "title": "지연 시간",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      }
    },
    {
      "id": 7,
      "title": "스캔 소요 시간",
      "description": "락을 획득한 매칭 엔진 스캔 1회가 걸린 시간입니다. 알고리즘 버전 간 비교에는 p95/p99를 우선 확인합니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "1000 * sum(rate(match_engine_scan_duration_seconds_sum{instance=~\"$instance\"}[1m])) / clamp_min(sum(rate(match_engine_scan_duration_seconds_count{instance=~\"$instance\"}[1m])), 0.001)",
          "legendFormat": "평균",
          "refId": "A"
        },
        {
          "expr": "1000 * histogram_quantile(0.95, sum(rate(match_engine_scan_duration_seconds_bucket{instance=~\"$instance\"}[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "1000 * histogram_quantile(0.99, sum(rate(match_engine_scan_duration_seconds_bucket{instance=~\"$instance\"}[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0
        }
      }
    },
    {
      "id": 8,
      "title": "매칭 성공 유저 대기 시간",
      "description": "매칭에 성공한 유저가 큐에서 기다린 시간입니다. p95가 낮을수록 엔진이 대기열을 빠르게 해소합니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(match_engine_matched_user_wait_duration_seconds_bucket{instance=~\"$instance\"}[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(match_engine_matched_user_wait_duration_seconds_bucket{instance=~\"$instance\"}[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        }
      }
    },
    {
      "id": 9,
      "title": "처리량",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      }
    },
    {
      "id": 10,
      "title": "초당 페어 수와 배치 선점 시도 수",
      "description": "성공한 페어 생산량과 Lua 원자 배치 선점 시도/실패량을 함께 비교합니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "expr": "sum(rate(match_engine_pairs_total{instance=~\"$instance\"}[1m]))",
          "legendFormat": "초당 페어 수",
          "refId": "A"
        },
        {
          "expr": "sum(rate(match_engine_atomic_batch_attempts_total{instance=~\"$instance\"}[1m]))",
          "legendFormat": "초당 배치 선점 시도 수",
          "refId": "B"
        },
        {
          "expr": "sum(rate(match_engine_atomic_batch_failures_total{instance=~\"$instance\"}[1m]))",
          "legendFormat": "초당 배치 선점 실패 수",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        }
      }
    },
    {
      "id": 11,
      "title": "스캔당 성사 페어 수",
      "description": "스캔 1회가 몇 개의 페어를 만들었는지 보여줍니다. 배치 매칭 효율 비교에 사용합니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "targets": [
        {
          "expr": "sum(rate(match_engine_pairs_per_scan_sum{instance=~\"$instance\"}[5m])) / clamp_min(sum(rate(match_engine_pairs_per_scan_count{instance=~\"$instance\"}[5m])), 0.001)",
          "legendFormat": "평균",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(match_engine_pairs_per_scan_bucket{instance=~\"$instance\"}[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "max(max_over_time(match_engine_pairs_per_scan_max{instance=~\"$instance\"}[5m]))",
          "legendFormat": "최대",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        }
      }
    },
    {
      "id": 12,
      "title": "큐와 스캔 입력",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      }
    },
    {
      "id": 13,
      "title": "티어별 현재 대기 인원",
      "description": "티어 점수별 현재 대기 유저 수입니다. 전체 큐 스캔이 아니라 ZSET 크기 조회로 측정합니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "max by (tier) (match_queue_size{instance=~\"$instance\"})",
          "legendFormat": "티어={{tier}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        }
      }
    },
    {
      "id": 14,
      "title": "스캔당 로드 티켓 수",
      "description": "엔진 스캔 1회가 로드한 티켓 수입니다. 스캔 소요 시간과 함께 보면 입력 규모 대비 알고리즘 비용을 판단할 수 있습니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "expr": "sum(rate(match_engine_scan_tickets_sum{instance=~\"$instance\"}[5m])) / clamp_min(sum(rate(match_engine_scan_tickets_count{instance=~\"$instance\"}[5m])), 0.001)",
          "legendFormat": "평균",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(match_engine_scan_tickets_bucket{instance=~\"$instance\"}[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "max(max_over_time(match_engine_scan_tickets_max{instance=~\"$instance\"}[5m]))",
          "legendFormat": "최대",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        }
      }
    },
    {
      "id": 15,
      "title": "joinQueue API 성능",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      }
    },
    {
      "id": 16,
      "title": "joinQueue 초당 요청 수",
      "description": "POST /api/v1/match/join 요청 처리량입니다. 두 API 인스턴스 합산 기준으로 봅니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 33
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{instance=~\"$instance\",method=\"POST\",uri=\"/api/v1/match/join\"}[1m]))",
          "legendFormat": "초당 요청 수",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        }
      }
    },
    {
      "id": 17,
      "title": "최근 30분 joinQueue 요청 수",
      "description": "선택한 시간 구간에서 증가한 POST /api/v1/match/join 요청 수입니다. 짧은 부하 테스트 결과 확인에는 초당 요청 수보다 이 값을 우선 확인합니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 33
      },
      "targets": [
        {
          "expr": "sum(increase(http_server_requests_seconds_count{instance=~\"$instance\",method=\"POST\",uri=\"/api/v1/match/join\"}[$__interval]))",
          "legendFormat": "요청 수",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        }
      }
    },
    {
      "id": 18,
      "title": "joinQueue p95 응답 시간",
      "description": "POST /api/v1/match/join 응답 시간 p95입니다. http.server.requests histogram 기반으로 계산합니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 33
      },
      "targets": [
        {
          "expr": "1000 * histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{instance=~\"$instance\",method=\"POST\",uri=\"/api/v1/match/join\"}[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 200
              },
              {
                "color": "red",
                "value": 500
              }
            ]
          }
        }
      }
    },
    {
      "id": 19,
      "title": "joinQueue 에러율",
      "description": "POST /api/v1/match/join 요청 중 5xx 응답 비율입니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 33
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{instance=~\"$instance\",method=\"POST\",uri=\"/api/v1/match/join\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{instance=~\"$instance\",method=\"POST\",uri=\"/api/v1/match/join\"}[5m])), 0.001) * 100",
          "legendFormat": "5xx 비율",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      }
    },
    {
      "id": 20,
      "title": "joinQueue 4xx 비율",
      "description": "POST /api/v1/match/join 요청 중 4xx 응답 비율입니다. 부하 테스트 데이터 중복, 인증 실패, 이미 대기 중 상태 등을 확인합니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 37
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{instance=~\"$instance\",method=\"POST\",uri=\"/api/v1/match/join\",status=~\"4..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{instance=~\"$instance\",method=\"POST\",uri=\"/api/v1/match/join\"}[5m])), 0.001) * 100",
          "legendFormat": "4xx 비율",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        }
      }
    },
    {
      "id": 21,
      "title": "joinQueue 인스턴스별 처리량",
      "description": "두 API 인스턴스가 joinQueue 요청을 어느 정도 나누어 처리하는지 확인합니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 41
      },
      "targets": [
        {
          "expr": "sum by (instance) (rate(http_server_requests_seconds_count{instance=~\"$instance\",method=\"POST\",uri=\"/api/v1/match/join\"}[1m]))",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        }
      }
    },
    {
      "id": 22,
      "title": "joinQueue 응답 시간",
      "description": "POST /api/v1/match/join 평균, p95, p99 응답 시간입니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 41
      },
      "targets": [
        {
          "expr": "1000 * sum(rate(http_server_requests_seconds_sum{instance=~\"$instance\",method=\"POST\",uri=\"/api/v1/match/join\"}[1m])) / clamp_min(sum(rate(http_server_requests_seconds_count{instance=~\"$instance\",method=\"POST\",uri=\"/api/v1/match/join\"}[1m])), 0.001)",
          "legendFormat": "평균",
          "refId": "A"
        },
        {
          "expr": "1000 * histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{instance=~\"$instance\",method=\"POST\",uri=\"/api/v1/match/join\"}[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "1000 * histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{instance=~\"$instance\",method=\"POST\",uri=\"/api/v1/match/join\"}[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0
        }
      }
    },
    {
      "id": 23,
      "title": "joinQueue 상태 코드별 요청 수",
      "description": "POST /api/v1/match/join 응답 상태별 초당 요청 수입니다.",
