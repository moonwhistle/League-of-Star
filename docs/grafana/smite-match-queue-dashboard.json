{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "League of Smite - Match Queue",
  "uid": "smite-match-queue",
  "timezone": "browser",
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": ["smite", "matching"],
  "time": { "from": "now-30m", "to": "now" },
  "panels": [

    {
      "id": 1,
      "title": "📊 Row: 처리량",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },

    {
      "id": 2,
      "title": "분당 대기열 진입 성공 수",
      "description": "match_queue_join_total{result='success'} 기준 1분 평균",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "sum(rate(match_queue_join_total{result=\"success\"}[1m])) by (tier)",
          "legendFormat": "tier={{tier}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" }
        }
      }
    },

    {
      "id": 3,
      "title": "분당 대기열 취소 성공 수",
      "description": "match_queue_leave_total{result='success'} 기준 1분 평균",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "sum(rate(match_queue_leave_total{result=\"success\"}[1m])) by (tier)",
          "legendFormat": "tier={{tier}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" }
        }
      }
    },

    {
      "id": 4,
      "title": "📊 Row: 처리 시간 (Latency)",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }
    },

    {
      "id": 5,
      "title": "joinQueue 평균 처리 시간 (ms)",
      "description": "성공 케이스 기준 평균 레이턴시",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "targets": [
        {
          "expr": "1000 * rate(match_queue_join_duration_seconds_sum{result=\"success\"}[1m]) / rate(match_queue_join_duration_seconds_count{result=\"success\"}[1m])",
          "legendFormat": "avg (success)",
          "refId": "A"
        },
        {
          "expr": "1000 * histogram_quantile(0.95, rate(match_queue_join_duration_seconds_bucket{result=\"success\"}[5m]))",
          "legendFormat": "p95 (success)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms" }
      }
    },

    {
      "id": 6,
      "title": "leaveQueue 평균 처리 시간 (ms)",
      "description": "성공 케이스 기준 평균 레이턴시",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "targets": [
        {
          "expr": "1000 * rate(match_queue_leave_duration_seconds_sum{result=\"success\"}[1m]) / rate(match_queue_leave_duration_seconds_count{result=\"success\"}[1m])",
          "legendFormat": "avg (success)",
          "refId": "A"
        },
        {
          "expr": "1000 * histogram_quantile(0.95, rate(match_queue_leave_duration_seconds_bucket{result=\"success\"}[5m]))",
          "legendFormat": "p95 (success)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms" }
      }
    },

    {
      "id": 7,
      "title": "📊 Row: 동시성 & 대기열 현황",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 }
    },

    {
      "id": 8,
      "title": "현재 In-flight 요청 수",
      "description": "현재 처리 중인 joinQueue / leaveQueue 동시 요청 수 (AtomicInteger 기반)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "targets": [
        {
          "expr": "match_queue_join_inflight",
          "legendFormat": "joinQueue in-flight",
          "refId": "A"
        },
        {
          "expr": "match_queue_leave_inflight",
          "legendFormat": "leaveQueue in-flight",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      }
    },

    {
      "id": 9,
      "title": "티어별 대기열 현재 인원",
      "description": "match_queue_size — 티어별 현재 대기 인원 수",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "targets": [
        {
          "expr": "match_queue_size",
          "legendFormat": "tier={{tier}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        }
      }
    },

    {
      "id": 10,
      "title": "📊 Row: 오류 & 경합",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 }
    },

    {
      "id": 11,
      "title": "진입 실패 비율 (duplicate vs error)",
      "description": "SETNX 경합(duplicate) 및 Redis 오류(error) 비율",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "targets": [
        {
          "expr": "sum(rate(match_queue_join_total{result=\"duplicate\"}[5m]))",
          "legendFormat": "중복 진입 (SETNX 경합)",
          "refId": "A"
        },
        {
          "expr": "sum(rate(match_queue_join_total{result=\"error\"}[5m]))",
          "legendFormat": "Redis 오류",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      }
    },

    {
      "id": 12,
      "title": "취소 실패 비율 (not_in_queue vs error)",
      "description": "not_in_queue: 비대기 상태 취소 시도 또는 엔진 선점. error: Redis 오류",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "targets": [
        {
          "expr": "sum(rate(match_queue_leave_total{result=\"not_in_queue\"}[5m]))",
          "legendFormat": "대기 상태 아님 / 엔진 선점",
          "refId": "A"
        },
        {
          "expr": "sum(rate(match_queue_leave_total{result=\"error\"}[5m]))",
          "legendFormat": "Redis 오류",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      }
    },

    {
      "id": 13,
      "title": "📊 Row: 요약 Stat",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 }
    },

    {
      "id": 14,
      "title": "전체 진입 성공률",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 37 },
      "targets": [
        {
          "expr": "sum(rate(match_queue_join_total{result=\"success\"}[5m])) / sum(rate(match_queue_join_total[5m])) * 100",
          "legendFormat": "성공률 (%)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 90 },
              { "color": "green", "value": 99 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },

    {
      "id": 15,
      "title": "전체 취소 성공률",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 37 },
      "targets": [
        {
          "expr": "sum(rate(match_queue_leave_total{result=\"success\"}[5m])) / sum(rate(match_queue_leave_total[5m])) * 100",
          "legendFormat": "성공률 (%)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 90 },
              { "color": "green", "value": 99 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },

    {
      "id": 16,
      "title": "피크 joinQueue In-flight",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 37 },
      "targets": [
        {
          "expr": "max_over_time(match_queue_join_inflight[30m])",
          "legendFormat": "max (30m)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },

    {
      "id": 17,
      "title": "전체 대기 인원",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 37 },
      "targets": [
        {
          "expr": "sum(match_queue_size)",
          "legendFormat": "전체 대기 인원",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    }

  ]
}
